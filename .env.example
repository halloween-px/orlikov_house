NEXT_PUBLIC_SITE_URL=https://orlikovhome.ru

# Номер счётчика Яндекс Метрики. Приставка NEXT_PUBLIC_ нужна, чтобы счётчик попал в браузер.
NEXT_PUBLIC_YANDEX_METRIKA_ID=113733120

# Куда приходят заявки с сайта
LEAD_TO_EMAIL=yaitskayayu@yandex.ru

# Секрет для anti-spam токена формы (любая длинная случайная строка)
LEAD_SECRET=change-me-to-a-long-random-string

# --- Админка /admin ---
ADMIN_LOGIN=admin
# Если пароль пустой, локально можно войти как admin / admin. На сервере задайте свой.
ADMIN_PASSWORD=придумайте-сложный-пароль
ADMIN_SECRET=другая-длинная-случайная-строка

# MongoDB на сервере
MONGODB_URI=mongodb://127.0.0.1:27017/orlikov_home

# Секрет, которым квиз подписывает заявки в /api/leads/ingest.
# Та же строка должна стоять в LEAD_INGEST_SECRET у квиза.
LEAD_INGEST_SECRET=отдельная-длинная-случайная-строка

# Уведомления о заявках в Telegram. Токен выдаёт @BotFather.
# TELEGRAM_CHAT_ID — id личного чата или группы, куда добавлен бот.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Вариант A: Yandex SMTP ---
# Создайте пароль приложения: https://id.yandex.ru/security/app-passwords
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=yaitskayayu@yandex.ru
SMTP_PASS=пароль приложения
SMTP_FROM=yaitskayayu@yandex.ru

# --- Вариант B: Resend (если SMTP не используете) ---
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Орликов дом <onboarding@resend.dev>
